# Upstream provider (OpenAI, Groq, OpenRouter, vLLM, Ollama, ...). Must be OpenAI-compatible.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=sk-replace-me

# Keys your own callers must present. Comma-separated; leave empty to allow BYOK
# (callers pass their own upstream key and you only meter, you don't gate).
GATEWAY_API_KEYS=

# Protects /usage and /metrics (either X-Admin-Token header or ?token=). Leave
# empty on localhost; set it on any public domain or your spend data is world-readable.
ADMIN_TOKEN=

# Postgres on Railway: reference the database service, sqlalchemy driver is added for you
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# USD per 1M tokens. Defaults apply to any model not listed.
DEFAULT_PRICE_IN_PER_1M=0
DEFAULT_PRICE_OUT_PER_1M=0
MODEL_PRICES={"gpt-4o-mini":{"in":0.15,"out":0.6}}
UPSTREAM_TIMEOUT_SECONDS=120
LOG_LEVEL=info
